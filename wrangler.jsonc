{
  // Cloudflare Workers: Qarzim ilovasini statik sahifa sifatida joylash.
  // Node server (server.js) Workers'da ishlamaydi. Server olinguncha bulut (login, sinxronlash) D1 bazasida saqlanadi:
  // "qarzim-db" bazasi birinchi deploy'da avtomatik yaratiladi.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "qarzim",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./qarz-daftar-app-v13-fix2/qarz-daftar-app",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/index.html", "/privacy", "/privacy.html", "/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "qarzim-db" }
  ],
  "vars": {
    "PRIVACY_OWNER": "",
    "PRIVACY_CONTACT": ""
  }
}
